<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClaudeUsageOrb</AssemblyName>
    <RootNamespace>ClaudeUsageOrb</RootNamespace>
    <StartupObject>ClaudeUsageOrb.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\orb.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Claude Usage Orb</Product>
    <Description>Tiny always-on-top orb that shows your remaining Claude plan usage.</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- WPF Fluent theme (ThemeMode / Fluent resource dictionaries) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\orb.ico" />
    <InternalsVisibleTo Include="ClaudeUsageOrb.Tests" />
  </ItemGroup>

</Project>

